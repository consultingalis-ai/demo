# opsforma · bezbednosna zaglavlja (Cloudflare Pages)
# Pravila važe redom, od opšteg ka posebnom. „! Ime“ uklanja zaglavlje koje je postavilo ranije pravilo,
# pa posebno pravilo ne dodaje drugu vrednost uz staru.
#
# Za ceo sajt: HTTPS uvek (HSTS), sajt ne može da se ugradi u tuđi sajt (clickjacking),
# pregledač ne nagađa tip fajla, bez pristupa kameri, mikrofonu, lokaciji i plaćanju.
# Bez „preload“ u HSTS dok ne prođe nekoliko nedelja bez problema (dodaje se i u Cloudflare-u).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Premium primeri: panel vlasnika čita QR kod kamerom (skener), pa kamera sme samo sa našeg sajta.
/premium/*
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()

# Stranice opsforme (ne primeri): stroga pravila o tome šta stranica sme da učita.
# Spolja samo: Cloudflare Web Analytics, Web3Forms (forma) i hCaptcha (zaštita forme).
# 'unsafe-inline' za skripte ostaje dok su skripte u samim stranicama (tema, meni, forma).
# Nova stranica opsforme dobija isto pravilo: dodaj njenu putanju ispod.
/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://hcaptcha.com https://*.hcaptcha.com; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com https://hcaptcha.com https://*.hcaptcha.com; frame-src https://hcaptcha.com https://*.hcaptcha.com; form-action 'self' https://api.web3forms.com; manifest-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests

